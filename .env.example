# Copy to .env and fill in. Never commit .env.

# --- Required for Docker Compose databases ---
POSTGRES_PASSWORD=
ELASTIC_PASSWORD=

# --- External Jira/Xray MCP server (assumed already deployed and running) ---
# Streamable HTTP endpoint. Host/port below is a local-dev example.
XRAY_MCP_URL=http://127.0.0.1:3100/mcp
# Only needed if your server's tool names differ from the defaults. JSON: logical
# operation -> "tool_name", or -> {"name": "...", "args": {"projectKey": "project_key"}}.
# Check with: curl localhost:8000/integrations/mcp/tools
# XRAY_MCP_TOOL_MAP={"get_test":"my_fetch_test"}
# XRAY_MCP_UNWRAP_DATA=1     # 0 if your server returns a literal top-level "data" field
# MCP_TOOL_TIMEOUT_SEC=60

# --- Atlassian / Xray (test sync + MCP credentials on the MCP server / Cloud) ---
JIRA_DOMAIN=
CONFLUENCE_DOMAIN=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# --- GitLab PRD ingestion ---
GITLAB_HOST=gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# --- LLM (at least one provider for analysis) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Analysis quality / context budget ---
# Coverage analysis is low-volume, high-stakes and human-reviewed, so the default favours
# capability over cost. Switch to a cheaper model for high-volume use.
# QA_DEFAULT_PROVIDER=anthropic
# QA_DEFAULT_MODEL=claude-opus-5
# Extended thinking on the Anthropic path — the keep/update/deprecate call is a judgement
# task, which is where reasoning helps most. Set to "off" to disable.
# QA_ANTHROPIC_THINKING=adaptive
# QA_ANTHROPIC_EFFORT=high          # low | medium | high | xhigh | max ("" to omit)
# Thinking tokens are drawn from this budget — too low and responses truncate mid-reasoning.
# QA_AGENT_MAX_OUTPUT_TOKENS=32000
# Cache the system prefix (resent every turn). Biggest single cost lever on Anthropic.
# QA_PROMPT_CACHING=1
# The conversation budget is derived from the model's real context window. Override only if
# the built-in table is wrong for your deployment (e.g. a custom Azure deployment name).
# QA_AGENT_CONTEXT_LIMIT=
# Share of the budget a single read_prd_document result may occupy; the rest is needed for
# search results and test details. Oversized PRDs return an outline + section pagination.
# QA_PRD_READ_BUDGET_RATIO=0.4
# Per-run cost reporting for models not in the built-in price table: "model:in:out" per MTok
# QA_MODEL_PRICES=
# Force knowledge inlining vs on-demand reads (default: inline when the prefix is cached)
# QA_AGENT_KNOWLEDGE_MODE=

# --- Local inference via Ollama (provider="ollama") ---
# Ollama runs on the host; the container reaches it through host.docker.internal.
# The model MUST support native tool calling — the analysis agent is tool-driven and a
# model that only describes tool calls in prose will record zero decisions.
# Verify with:  curl -s localhost:11434/api/show -d '{"model":"<tag>"}' | grep -i tool
# QA_DEFAULT_PROVIDER=ollama
# QA_DEFAULT_MODEL=<your ollama tag>
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama's default context window is a few thousand tokens regardless of the model's
# real limit, and anything past it is dropped WITHOUT error. Set this to fit your PRD.
# OLLAMA_NUM_CTX=32768
# OLLAMA_KEEP_ALIVE=30m      # keep the model resident; cold loads dominate per-turn cost
# OLLAMA_TIMEOUT_SEC=600
# Lower the turn cap for local runs — 40 turns on a 12B model can take hours.
# QA_AGENT_MAX_TURNS=20
# QA_AGENT_MAX_OUTPUT_TOKENS=4096
# Re-prompts allowed when the model replies in prose instead of calling a tool.
# QA_AGENT_MAX_NO_TOOL_NUDGES=2

# --- Optional ---
# Analysis run_id = deterministic UUID from PRD + module + UTC minute (set to 0 for random UUID)
# QA_DETERMINISTIC_ANALYSIS_RUN_ID=1
# QA_ANALYSIS_RUN_ID_SALT=
# Append-only audit ledger JSONL (default: qa-agent/eval/phase-ledger.jsonl)
# QA_PHASE_LEDGER_PATH=
QA_ENGINE_API_KEY=
XRAY_PROJECT_KEY=
HF_TOKEN=
REVIEW_UI_PASSWORD=
